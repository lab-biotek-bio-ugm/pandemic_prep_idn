"""
Module 10: In-silico PCR Coverage Analysis
Validates candidate primers and probes against a large sequence database using seqkit amplicon
and calculates coverage metrics broken down by subtype, collection year, and country.
"""

def get_m10_input_markers(wildcards):
    """Return the M09 verification_complete.txt markers as M10 dependencies.
    We depend on markers (not final_candidates.json) because final_candidates.json
    is only generated by M09 when at least one candidate passes BLAST thresholds.
    The Python script will find final_candidates.json files from m09_dirs at runtime.
    """
    import yaml
    # Force Snakemake to evaluate checkpoint m07_bridge
    checkpoint_output = checkpoints.m07_bridge.get(BUILD=BUILD)
    manifest_path = checkpoint_output.output.manifest
    
    with open(manifest_path, "r") as f:
        manifest = yaml.safe_load(f)
    
    regions = [r["region_id"] for r in manifest.get("candidate_regions", [])]
    return [
        f"results/{BUILD}/m09/{wildcards.mode}/{region}/verification_complete.txt"
        for region in regions
    ]

def get_m10_m09_dirs(wildcards):
    """Return list of m09 region subdirectory paths for Python script to discover candidates."""
    import yaml
    checkpoint_output = checkpoints.m07_bridge.get(BUILD=BUILD)
    manifest_path = checkpoint_output.output.manifest
    
    with open(manifest_path, "r") as f:
        manifest = yaml.safe_load(f)
    
    regions = [r["region_id"] for r in manifest.get("candidate_regions", [])]
    return " ".join([
        f"results/{BUILD}/m09/{wildcards.mode}/{region}"
        for region in regions
    ])

def get_m10_threads(wildcards):
    """Return the number of threads to use. Defaults to 8 if not defined.

    `workflow.cores` RAISES WorkflowError when --cores was not supplied; it does
    not return None. The previous `is not None` guard therefore triggered the very
    error it was written to avoid, so a plain `snakemake -n` (or --unlock) aborted
    with "Workflow requires a total number of cores to be defined" as soon as this
    rule was reached, even though a dry run needs no cores at all.
    """
    try:
        cores = workflow.cores
    except Exception:
        return 8
    return cores if cores else 8

rule m10_insilico_pcr:
    """
    Executes in-silico PCR simulation using seqkit amplicon and custom Python scripts
    to validate candidate coverage against a large sequence database.
    Depends on M09 verification markers; discovers final_candidates.json at runtime.
    """
    input:
        markers=get_m10_input_markers,
        sequences=config["local_input"]["sequences"],
        metadata=config["local_input"]["metadata"],
        gff=config["references"]["annotation"],
        design_sequences="results/{BUILD}/m02/filtered_sequences.fasta"
    output:
        summary_tsv="results/{BUILD}/m10/{mode}/coverage_summary.tsv",
        summary_json="results/{BUILD}/m10/{mode}/coverage_summary.json",
        report_md="results/{BUILD}/m10/{mode}/coverage_report.md",
        heatmap_html="results/{BUILD}/m10/{mode}/coverage_heatmap.html",
        gff3_track="results/{BUILD}/m10/{mode}/m10_candidates.gff3"
    params:
        max_mismatch=config["insilico_pcr"].get("max_mismatch", 3),
        num_candidates=config["insilico_pcr"].get("num_candidates", 10),
        outdir="results/{BUILD}/m10/{mode}",
        m09_dirs=get_m10_m09_dirs,
        raa_3prime_bp=config["insilico_pcr"].get("raa_3prime_bp", 4),
        raa_max_3prime_mm=config["insilico_pcr"].get("raa_max_3prime_mm", 1),
        raa_max_internal_mm=config["insilico_pcr"].get("raa_max_internal_mm", 4),
        raa_probe_max_mm=config["insilico_pcr"].get("raa_probe_max_mm", 5),
        min_subtype_seqs=config["insilico_pcr"].get("min_subtype_seqs", 30)
    threads:
        get_m10_threads
    conda:
        "../envs/m10_insilico.yaml"
    log:
        "logs/{BUILD}/m10/insilico_pcr_{mode}.log"
    shell:
        """
        python scripts/m10_insilico_pcr.py \
            --m09-dirs {params.m09_dirs} \
            --sequences {input.sequences} \
            --metadata {input.metadata} \
            --gff {input.gff} \
            --design-sequences {input.design_sequences} \
            --outdir {params.outdir} \
            --max-mismatch {params.max_mismatch} \
            --num-candidates {params.num_candidates} \
            --raa-3prime-bp {params.raa_3prime_bp} \
            --raa-max-3prime-mm {params.raa_max_3prime_mm} \
            --raa-max-internal-mm {params.raa_max_internal_mm} \
            --raa-probe-max-mm {params.raa_probe_max_mm} \
            --min-subtype-seqs {params.min_subtype_seqs} \
            --threads {threads} > "{log}" 2>&1
        """

def get_m10_compare_inputs(wildcards):
    inputs = {
        "non_degenerate": f"results/{BUILD}/m10/non_degenerate/coverage_summary.json"
    }
    
    # Optional degenerate summary input
    deg_enabled = config.get("primerlab", {}).get("design", {}).get("degenerate", {}).get("enabled", False)
    if deg_enabled:
        inputs["degenerate"] = f"results/{BUILD}/m10/degenerate/coverage_summary.json"
        
    return inputs

rule m10_compare_runs:
    """
    Compares the coverage and thermodynamic results between the non-degenerate and
    degenerate tracks, generating a unified visual HTML comparison report.
    """
    input:
        unpack(get_m10_compare_inputs)
    output:
        report=f"results/{BUILD}/m10/comparison_report.html",
        marker=f"results/{BUILD}/m10/comparison_complete.txt"
    log:
        f"logs/{BUILD}/m10/compare_runs.log"
    params:
        build_name=BUILD,
        deg_summary=lambda wildcards, input: getattr(input, "degenerate", "")
    conda:
        "../envs/m10_insilico.yaml"
    shell:
        """
        python scripts/m10_compare_runs.py \
            --non-degenerate-summary {input.non_degenerate} \
            --degenerate-summary "{params.deg_summary}" \
            --output-report {output.report} \
            --output-marker {output.marker} \
            --build-name "{params.build_name}" > "{log}" 2>&1
        """
